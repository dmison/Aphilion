
.panel.show {
    background-color: rgba(0, 0, 0, 0.84);
    visibility: visible;
}


.panel {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    align-items: center; 
    justify-content: center; 
    align-self: stretch;
    transition-property: background-color;
    transition-duration: 3s;
    visibility: hidden;
}

.diedText {
    -unity-text-align: middle-center; 
    white-space: normal; 
    text-overflow: clip;
    transition-property: color, letter-spacing;
    transition-duration: 2s;
    color: rgb(112, 0, 0); 
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 0px;


    /*-unity-font-definition: initial;*/
    /*-unity-text-outline-width: 1px; */
    /*text-shadow: 3px 3px 20px rgba(0, 0, 0, 0);*/
}

.panel.show .diedText {
    color: rgb(161, 0, 0);
    letter-spacing: 20px;
/*    opacity: 100;*/
}