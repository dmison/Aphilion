                <mxCell id="107" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Scene Loading&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;When player is in a &lt;b&gt;region&lt;/b&gt; scene, it&#39;s ajoining transition scenes must also be loaded&lt;/li&gt;&lt;li&gt;when a player is in a &lt;b&gt;transition&lt;/b&gt; scene, it&#39;s ajoining region scenes must be loaded&lt;/li&gt;&lt;li&gt;all other scenes should be unloaded&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="1760" y="186" width="670" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="108" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Transition scenes&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;small scenes which connect regions&lt;/li&gt;&lt;li&gt;region scenes should not be visible from transition scenes, OR the transition scene should contain&lt;br&gt;copies of the visible assets OR other placeholders&amp;nbsp;&lt;/li&gt;&lt;li&gt;all other scenes should be unloaded&lt;/li&gt;&lt;li&gt;LOS needs to be blocked between all exits&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="1754" y="320" width="670" height="150" as="geometry"/>
                </mxCell>
