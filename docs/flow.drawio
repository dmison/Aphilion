        <mxCell id="I-TNLLBIKghRffwVaEJ6-72" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Scene Loading&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;When player is in a &lt;b&gt;region&lt;/b&gt; scene, it&#39;s ajoining transition scenes must also be loaded&lt;/li&gt;&lt;li&gt;when a player is in a &lt;b&gt;transition&lt;/b&gt; scene, it&#39;s ajoining region scenes must be loaded&lt;/li&gt;&lt;li&gt;all other scenes should be unloaded&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="I-TNLLBIKghRffwVaEJ6-1">
          <mxGeometry x="1660" y="180" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="I-TNLLBIKghRffwVaEJ6-73" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Transition scenes&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;small scenes which connect regions&lt;/li&gt;&lt;li&gt;region scenes should not be visible from transition scenes, OR the transition scene should contain&lt;br&gt;copies of the visible assets OR other placeholders&amp;nbsp;&lt;/li&gt;&lt;li&gt;all other scenes should be unloaded&lt;/li&gt;&lt;li&gt;LOS needs to be blocked between all exits&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="I-TNLLBIKghRffwVaEJ6-1">
          <mxGeometry x="1654" y="314" width="576" height="150" as="geometry" />
        </mxCell>
        <mxCell id="I-TNLLBIKghRffwVaEJ6-74" value="World Scene" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#182E3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;" vertex="1" parent="I-TNLLBIKghRffwVaEJ6-1">
          <mxGeometry x="1230" y="184" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I-TNLLBIKghRffwVaEJ6-75" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;World Scene&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;singleton manager objects&lt;/li&gt;&lt;li&gt;player&lt;/li&gt;&lt;li&gt;player ui&lt;/li&gt;&lt;li&gt;menus&lt;/li&gt;&lt;li&gt;player camera&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="I-TNLLBIKghRffwVaEJ6-1">
          <mxGeometry x="1660" y="474" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="I-TNLLBIKghRffwVaEJ6-76" value="Main Menu Scene" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#182E3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;" vertex="1" parent="I-TNLLBIKghRffwVaEJ6-1">
          <mxGeometry x="1230" y="50" width="120" height="40" as="geometry" />
        </mxCell>
