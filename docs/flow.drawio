                <mxCell id="I-TNLLBIKghRffwVaEJ6-72" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Scene Loading&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;When player is in a &lt;b&gt;region&lt;/b&gt; scene, it&#39;s ajoining transition scenes must also be loaded&lt;/li&gt;&lt;li&gt;when a player is in a &lt;b&gt;transition&lt;/b&gt; scene, it&#39;s ajoining region scenes must be loaded&lt;/li&gt;&lt;li&gt;all other scenes should be unloaded&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="I-TNLLBIKghRffwVaEJ6-1" vertex="1">
